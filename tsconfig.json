{
  "compilerOptions": {
    "jsx": "preserve",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
   "baseUrl": ".",                      // ★ 追加
    "paths": {
      "@/*": ["./src/*"],
     "thirdweb/dist/types/react/web/ui/ConnectWallet/defaultTokens.js": [
       "./thirdweb-defaultTokens-shim"
     ]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "thirdweb-shims.d.ts"
  ],
  "exclude": ["node_modules"]
}

